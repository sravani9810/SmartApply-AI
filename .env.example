# Optional Google Sheets sync for the job-search pipeline (Part 1).
# Leave unset to keep the pipeline local-only (Excel workbook only).
# Copy to .env and fill in — .env is gitignored.

# Absolute path to your service-account JSON key FILE (not a URL!).
# This is the .json you downloaded from the service account's "Keys" tab.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/smartapply/service-account.json

# The spreadsheet ID from the sheet URL. Either the bare ID or the full URL
# works — the code extracts the ID:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab (worksheet) name to write to. Optional; defaults to "Jobs".
GOOGLE_SHEETS_TAB=Jobs

# --- Your search preferences (change these to update what's searched) ---
# Job title / keywords, comma-separated.
JOB_KEYWORDS=software engineer, typescript
# Where to search: "Remote", "Bengaluru, India", "New York, NY", etc.
JOB_LOCATION=Remote
# Only include jobs posted within this many days.
JOB_POSTED_WITHIN_DAYS=7

# Optional: run MULTIPLE searches in one go (overrides JOB_KEYWORDS/JOB_LOCATION).
# Pipe-separated "keywords @ location" entries; all feed the same sheet (deduped).
# JOB_SEARCHES=software engineer @ Remote | data analyst @ Bengaluru, India | product manager @ New York, NY

# --- Live Indeed connector (drives a logged-in Chrome profile) ---
# Set to "true" to fetch live Indeed results instead of the synthetic sample.
INDEED_ENABLED=true

# Where the dedicated Chrome profile (with your Indeed login) is stored.
# Optional; defaults to ~/.config/smartapply/chrome-profile
# INDEED_PROFILE_DIR=/Users/you/.config/smartapply/chrome-profile

# Set to "false" to watch the browser while it scrapes (useful for debugging).
# Optional; default is headless.
# INDEED_HEADLESS=false

# --- Live LinkedIn connector (drives a logged-in Chrome profile) ---
# Set to "true" to also fetch live LinkedIn results. Sign in once with
# `npm run login:linkedin`, then run the pipeline.
# LINKEDIN_ENABLED=true

# Where the dedicated Chrome profile (with your LinkedIn login) is stored.
# Optional; defaults to ~/.config/smartapply/linkedin-profile
# LINKEDIN_PROFILE_DIR=/Users/you/.config/smartapply/linkedin-profile

# Set to "true" to run headless (LinkedIn's auth wall usually blocks it).
# Optional; default is headed.
# LINKEDIN_HEADLESS=true

# How many times to scroll the results to load more cards (default 4), and
# whether to open each posting for its full description (default on).
# LINKEDIN_SCROLLS=4
# LINKEDIN_FETCH_DESCRIPTIONS=false
# LINKEDIN_MAX_DESCRIPTIONS=25
