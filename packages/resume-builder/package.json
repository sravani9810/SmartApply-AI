{
  "name": "@smartapply/resume-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Part 4 — data-driven resume/CV builder that renders a ResumeData JSON to a downloadable PDF (puppeteer locally, PDFShift in production).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:styles": "npx tailwindcss -o public/build.css --minify ",
    "start": "next start",
    "lint": "next lint",
    "pdf:open": "npm run build:styles && open http://localhost:3000/api/cv",
    "pdf:download": "npm run build:styles && curl -o public/cv.pdf http://localhost:3000/api/cv"
  },
  "dependencies": {
    "next": "12.0.8",
    "puppeteer": "22.13.0",
    "puppeteer-core": "22.13.0",
    "puppeteer-extra": "3.3.6",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@types/node": "17.0.10",
    "@types/react": "17.0.38",
    "@types/react-dom": "^17.0.11",
    "autoprefixer": "^10.4.2",
    "eslint": "8.7.0",
    "eslint-config-next": "12.0.8",
    "eslint-config-prettier": "^8.3.0",
    "postcss": "^8.4.5",
    "prettier": "^2.5.1",
    "tailwindcss": "^3.4.6",
    "typescript": "4.5.5"
  }
}
