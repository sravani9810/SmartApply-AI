{
  "name": "smartapply-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Automated job-search pipeline, organized into three parts: job discovery, autofill extension, and resume matching.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "search": "npm run start --workspace @smartapply/job-search",
    "login:indeed": "npm run login:indeed --workspace @smartapply/job-search",
    "import:indeed": "npm run import:indeed --workspace @smartapply/job-search"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
