{
  "name": "smartapply-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Automated job-search pipeline: job discovery, autofill extension, resume matching, and resume building.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "search": "npm run start --workspace @smartapply/job-search",
    "login:indeed": "npm run login:indeed --workspace @smartapply/job-search",
    "login:linkedin": "npm run login:linkedin --workspace @smartapply/job-search",
    "import:indeed": "npm run import:indeed --workspace @smartapply/job-search",
    "schedule:on": "npm run schedule:on --workspace @smartapply/job-search",
    "schedule:off": "npm run schedule:off --workspace @smartapply/job-search",
    "schedule:now": "npm run schedule:now --workspace @smartapply/job-search",
    "schedule:status": "npm run schedule:status --workspace @smartapply/job-search",
    "resume:dev": "npm run dev --workspace @smartapply/resume-builder",
    "resume:build": "npm run build --workspace @smartapply/resume-builder",
    "resume:start": "npm run start --workspace @smartapply/resume-builder",
    "hub:dev": "npm run dev --workspace @smartapply/hub",
    "hub": "concurrently -n resume,hub -c cyan,green \"npm:resume:dev\" \"npm:hub:dev\"",
    "dev": "npm run hub"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.3",
    "typescript": "^5.6.0"
  }
}
